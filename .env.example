# Copy to .env (never commit .env). In GitHub, add these as Actions secrets instead.
# Everything is optional - with no keys you still get the daily lead CSVs + marketing copy.

# Your details for the marketing copy
YOUR_NAME=
YOUR_COMPANY=
YOUR_PHONE=

# LLC piercing - GovFiles (https://govfiles.dev). Without it you get a free state SOS search link per LLC.
GOVFILES_API_KEY=

# Skip tracing - pick one provider: dealmachine or batchdata
SKIPTRACE_PROVIDER=
DEALMACHINE_API_KEY=
BATCHDATA_API_KEY=
SKIPTRACE_MAX_PER_RUN=100

# Outreach - Invelo has no public API; the run writes invelo_import.csv for you.
# For anything else (Zapier, Make, n8n, REsimpli, GoHighLevel...) paste a webhook URL:
OUTREACH_WEBHOOK_URL=

# Fetch providers (optional) - only for court/recorder portals that block plain scripts.
# Default order: Bright Data (if keyed) -> ScraperAPI (if keyed) -> plain fetch. Force with e.g. SCRAPER_PROVIDER=scraperapi,direct
# Only use them on sites whose terms of use allow automated access.
SCRAPER_PROVIDER=
# Bright Data Web Unlocker API: zone Overview tab shows the key + zone name
#   https://docs.brightdata.com/scraping-automation/web-unlocker/send-your-first-request
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
# Bright Data Browser API (Scraping Browser) for JavaScript search forms; needs `pip install playwright`
#   wss://brd-customer-<id>-zone-<zone>:<password>@brd.superproxy.io:9222
#   https://docs.brightdata.com/scraping-automation/scraping-browser/introduction
BRIGHTDATA_BROWSER_WSS=
# ScraperAPI (backup) https://docs.scraperapi.com
SCRAPERAPI_KEY=
# Seconds to wait between page requests (be polite)
FETCH_DELAY_SECONDS=2
